FROM ubuntu:26.04

LABEL maintaner="Roman Rabodzei" \
    maintainerEmail="roman.rabodzei@icloud.com" \
    description="Transmission Docker image" \
    version="1.1" \
    release-date="2024-07-29" \
    license="MIT" \
    source-code="https://github.com/romanrabodzei/transmission-docker"

# Update and get dependencies
RUN apt-get update && \
    apt-get upgrade -y

# Install Transmission and gosu (used to drop privileges at runtime)
RUN apt-get install -y \
    transmission-daemon \
    gosu

# Setup directories
RUN mkdir -p \
    /incompleted \
    /completed

# Set default ownership and permissions (re-applied at runtime by entrypoint.sh
# to also cover bind-mounted host directories)
RUN chown debian-transmission:debian-transmission /incompleted /completed && \
    chmod 755 /incompleted /completed

# Remove default configuration file
RUN rm -rf /etc/transmission-daemon/settings.json

# Copy correct configuration file
COPY ./settings.json /etc/transmission-daemon/

# Copy entrypoint script
COPY ./entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Cleanup old data
RUN apt-get -y autoremove && \
    apt-get -y clean

# Publish port
EXPOSE 8080/tcp

# Map volumes
VOLUME /incompleted /completed

# Default uid/gid for the debian-transmission user; override to match the
# owner of your bind-mounted /incompleted and /completed host directories
ENV PUID=100
ENV PGID=101

# Run transmission daemon in the foreground as PID 1
ENTRYPOINT ["/entrypoint.sh"]